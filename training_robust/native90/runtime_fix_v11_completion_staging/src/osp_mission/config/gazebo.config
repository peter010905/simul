<?xml version="1.0"?>
<window><width>1280</width><height>850</height></window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui><title>OSP Studio - TurtleBot4</title><property key="state" type="string">docked</property><property key="showTitleBar" type="bool">false</property></gz-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.8 0.8 0.8</ambient_light><background_color>0.15 0.18 0.23</background_color>
  <camera_pose>10.1 -8 34 0 1.19 1.5707963</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property key="visible" type="bool">false</property></gz-gui></plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control"><gz-gui><property key="visible" type="bool">false</property></gz-gui></plugin>
<plugin filename="WorldControl" name="World control"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">300</property><property key="height" type="double">70</property></gz-gui><play_pause>true</play_pause><step>true</step><start_paused>false</start_paused></plugin>
