+    def remember_bump(self, frames):
+        """.58: obstacles below the LiDAR plane are seen only by the bumper. Remember the
+        contact (front arc 0.22 m from the base, +-0.10 m wide) in the map frame so the
+        costmaps keep it (topic mission/known_obstacles is already a marking source)."""
+        try:
+            tr=self.tf.lookup_transform(self.p('map_frame'),self.p('base_frame'),Time())
+        except Exception:
+            return
+        q=tr.transform.rotation
+        yaw=math.atan2(2*(q.w*q.z+q.x*q.y),1-2*(q.y*q.y+q.z*q.z))
+        x0,y0=tr.transform.translation.x,tr.transform.translation.y
+        side=0.
+        names=' '.join(frames)
+        if 'left' in names and 'right' not in names: side=math.radians(40)
+        elif 'right' in names and 'left' not in names: side=-math.radians(40)
+        a=yaw+side
+        for lateral in (-.10,0.,.10):
