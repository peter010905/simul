@@ -6,9 +6,38 @@
 mode="${1:-pair}"
-case "$mode" in flow|mixed|center|adaptive|r32|pair|compare-mixed) ;; *) echo 'Choose pair, compare-mixed, r32, mixed, center, adaptive or flow' >&2; exit 2 ;; esac
+case "$mode" in flow|mixed|center|adaptive|shared|r32|pair|compare-mixed) ;; *) echo 'Choose pair, compare-mixed, r32, mixed, center, adaptive, shared or flow' >&2; exit 2 ;; esac
 mkdir -p "$runs/.layouts"
+# Pair trials reserve both slots. A single shared-face run can use the second
+# simulation domain when another observer is positively identified on 174.
+domain=174
 exec 9>"$runs/.domain.lock"
+exec 8>"$runs/.second-domain.lock"
 if [[ "$mode" == compare-mixed ]]; then
     flock 9
+    flock 8
+elif flock -n 9; then
+    if [[ "$mode" == pair ]]; then
+        flock -n 8 || { echo 'A track trial is already running' >&2; exit 75; }
+    fi
+elif [[ "$mode" == shared ]] && flock -n 8 && python3 - <<'PYTHON'
+from pathlib import Path
+import sys
+
+domains = []
+for proc in Path('/proc').glob('[0-9]*'):
+    try:
+        command = (proc/'cmdline').read_bytes().split(bytes([0]))
+        if not any(arg.endswith((b'/measure_video.py', b'/measure.py')) for arg in command):
+            continue
+        env = dict(pair.split(b'=',1) for pair in (proc/'environ').read_bytes().split(bytes([0])) if b'=' in pair)
+        if env.get(b'BENCH_RUN'):
+            domains.append((env.get(b'ROS_DOMAIN_ID'),env.get(b'ROS_LOCALHOST_ONLY')))
+    except (PermissionError, FileNotFoundError, ProcessLookupError):
+        continue
+sys.exit(0 if domains == [(b'174',b'1')] else 1)
+PYTHON
+then
+    domain=175
 else
-    flock -n 9 || { echo 'A track trial is already running' >&2; exit 75; }
+    echo 'A track trial is already running' >&2
+    exit 75
 fi
