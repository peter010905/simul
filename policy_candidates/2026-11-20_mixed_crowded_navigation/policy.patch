+    def navigation_result(self, status, reason, elapsed):
+        self.elapsed = elapsed
+        stamp = self.pending_attempt
+        if stamp is None:
+            return
+        if status==4:
+            self.failed_attempts.pop(stamp,None)
+        else:
+            self.failed_attempts[stamp] = elapsed+45.
+        sensor_pause = status==5 and reason in ('processed_camera_stale','scan_stale','map_unavailable',
+            'map_to_base_tf_unavailable','nav2_unavailable','drive_unavailable')
+        if not sensor_pause:
+            self.pending_attempt = None
+
     def attempts(self, kind, anchor, normal_yaw, radius):
         return [t for k,p,a,t in self.history if k == kind and
+                (t not in self.failed_attempts or self.elapsed < self.failed_attempts[t]) and
                 np.linalg.norm(anchor-p)<radius and math.cos(normal_yaw-a)>.70]

