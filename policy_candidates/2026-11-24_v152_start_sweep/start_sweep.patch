--- /dev/null
+++ b/marked_boxes.py
@@ -0,0 +1,62 @@
+"""Identify an inspected compact object from a registered ID on its mapped surface."""
+import math
+import cv2
+import numpy as np
+
+
+class MarkedBoxes:
+    def __init__(self):
+        self.by_component = {}
+        self.markers = {}
+        self.skipped = 0
+
+    def update(self, grid, occupied, bounds, interior, partial, targets):
+        # Component numbers change whenever SLAM updates. Rebind them using the
+        # persistent ID and current map position, including after ID withdrawal.
+        self.by_component.clear()
+        self.markers.clear()
+        self.skipped = 0
+        if not targets:
+            return
+        tolerance = max(.10, 2 * grid.resolution)
+        span = math.ceil(tolerance / grid.resolution) + 1
+        for ident, xy in targets.items():
+            r, c = grid.index(*xy)
+            if not grid.inside(r, c):
+                continue
+            r0, c0 = max(0, r-span), max(0, c-span)
+            tile = occupied[r0:r+span+1, c0:c+span+1]
+            near = set()
+            for y, x in np.argwhere(tile > 0):
+                if math.dist(grid.world(r0+y, c0+x), xy) <= tolerance:
+                    near.add(int(tile[y, x]))
+            if len(near) != 1:
+                continue
+            component = near.pop()
+            window = bounds[component-1]
+            if max(s.stop-s.start for s in window)*grid.resolution > 1.65:
+                continue
+            mask = occupied[window] == component
+            if component not in partial and not np.any(interior[window] & mask):
+                continue
+            pts = np.argwhere(mask).astype(np.float32)
+            if len(pts) < 5:
+                continue
+            _, dims, _ = cv2.minAreaRect(pts)
+            short, long = sorted(v*grid.resolution for v in dims)
+            if not (.14 <= short and .30 <= long <= 1.15):
+                continue
+            self.by_component.setdefault(component, set()).add(int(ident))
+            self.markers[int(ident)] = np.asarray(xy, dtype=float)
+
+    def fitted_done(self, center, faces):
+        # Fitted goals have no component index. Only suppress rectangles whose
+        # finite face segment coincides with an already attributed print.
+        for anchor, normal in faces:
+            tangent = np.array([-normal[1], normal[0]])
+            width = max(abs((p-center) @ tangent) for p, _ in faces)
+            for xy in self.markers.values():
+                delta = xy-anchor
+                if abs(delta @ normal) <= .10 and abs(delta @ tangent) <= width+.04:
+                    return True
+        return False
