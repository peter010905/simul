+def edge_fraction(points, angle, band=.06):
+    """Share of cells lying on the border of the rectangle aligned with angle."""
+    c, s = math.cos(angle), math.sin(angle)
+    projected = points @ np.array([[c, -s], [s, c]])
+    lo, hi = projected.min(axis=0), projected.max(axis=0)
+    near = np.minimum(projected-lo, hi-projected).min(axis=1) <= band
+    return float(near.mean())
 
+
+def box_axis(points, room_angle):
+    """Faces of one obstacle: LiDAR sees surfaces, so the right rectangle has its cells on
+    its border. Keep the room axis unless another angle fits clearly better."""
+    if len(points) < 12:
+        return room_angle
+    angles = np.radians(np.arange(90))
+    scores = [edge_fraction(points, a) for a in angles]
+    best = int(np.argmax(scores))
+    if room_angle is None:
+        return float(angles[best])
+    if scores[best] >= edge_fraction(points, room_angle)+.15:
+        return float(angles[best])
+    return room_angle
+
