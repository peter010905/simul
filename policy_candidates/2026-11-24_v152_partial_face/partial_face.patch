+def partial_face_pose(grid, cost, nav, distances, clearance, face, normal, half_width,
+                      pose, fields, veto, max_walk):
+    """Aim at a mapped portion of a confirmed box when its centre is still unknown."""
+    if half_width < 3 * grid.resolution:
+        return None
+    centre = grid.index(*(face + .12 * normal))
+    if not grid.inside(*centre) or grid.cells[centre] >= 0:
+        return None
+
+    # Only an unobserved strip contiguous with this confirmed face is eligible.
+    # A measured obstacle in the strip rules out this view entirely.
+    direction = np.array(normal)
+    gap_limit = min(.45, half_width + grid.resolution)
+    for gap in np.arange(.12, gap_limit + .001, .5 * grid.resolution):
+        boundary = face + gap * direction
+        cell = grid.index(*boundary)
+        if not grid.inside(*cell):
+            return None
+        value = grid.cells[cell]
+        if value > 25:
+            return None
+        if value < 0:
+            continue
+        # The camera aims toward the missing face, from a known safe viewpoint
+        # with a clear view of the known side of the mapping frontier.
+        point = boundary + grid.resolution * direction
+        outer = grid.index(*point)
+        if not grid.inside(*outer) or not 0 <= grid.cells[outer] <= 25:
+            continue
+
+        def unavailable(goal):
+            xy = (goal['x'], goal['y'])
+            return (distances[grid.index(*xy)] > max_walk or math.dist(xy, face) > 1.5
+                    or not grid.line_clear(xy, point) or veto(goal))
+
+        details = dict(fields, surface_map=face.tolist(), face_frontier_gap_m=float(gap))
+        view = inspection_pose(grid, cost, nav, distances, clearance, point, normal,
+                               half_width, pose, details, unavailable, visibility_offset=0.)
+        if view:
+            walk, goal = view
+            # Look through the visible frontier along the predicted side bearing.
+            # Credit still requires real RGB exposures and supported scan returns.
+            goal['yaw'] = math.atan2(face[1]-goal['y'], face[0]-goal['x']) - goal['scan_angle']/2
+            if not veto(goal):
+                return walk, goal
+        return None
+    return None
