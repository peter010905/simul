@@ -0,0 +1,50 @@
+"""A bounded glance at a tiny cue leaving the image; never proposes a destination."""
+import math
+
+
+class EdgeWatch:
+    def __init__(self):
+        self.previous = None
+        self.accepted = []
+
+    def offer(self, stamp, now, origin, camera_yaw, hits):
+        if not all(math.isfinite(v) for v in (*origin, stamp, now, camera_yaw)):
+            return None
+        if not -.1 <= now-stamp <= .5 or len(origin) != 2 or len(hits) > 8:
+            return None
+        old = self.previous
+        if old and stamp <= old[0]:
+            return None
+        rows = [tuple(h) for h in hits if len(h) == 4 and all(map(math.isfinite,h))
+                and 6 <= h[1] < 10 and .6 <= abs(h[2]) <= 1 and abs(h[3]) <= 1]
+        self.previous = stamp, tuple(origin), rows
+        if not old or not .075 <= stamp-old[0] <= .4 or math.dist(origin,old[1]) > .22:
+            return None
+        if len(self.accepted) >= 2 or (self.accepted and now-self.accepted[-1][0] < 30):
+            return None
+        matches = []
+        for bearing,size,x,y in rows:
+            if abs(x) < .82:
+                continue
+            compatible = [(s,px,py) for b,s,px,py in old[2]
+                          if abs(math.remainder(bearing-b, 2*math.pi)) <= math.radians(2.2)
+                          and x*px > 0 and abs(y-py) <= .10 and .64 <= size/s <= 1.56]
+            if len(compatible) != 1:
+                continue
+            last_size,last_x,_ = compatible[0]
+            if max(size,last_size) < 8 or abs(x)-abs(last_x) < .04:
+                continue
+            angle = math.remainder(bearing-camera_yaw, 2*math.pi)
+            if angle*x >= 0 or abs(angle) < math.radians(6):
+                continue
+            matches.append((bearing,math.copysign(math.radians(6),angle)))
+        if len(matches) != 1:
+            return None
+        bearing,angle = matches[0]
+        if any(math.dist(origin,p)<.8 and abs(math.remainder(bearing-b,2*math.pi)) < math.radians(12)
+               for _,p,b in self.accepted):
+            return None
+        return (now,tuple(origin),bearing,angle)
+
+    def commit(self, request):
+        self.accepted.append(request[:3])
