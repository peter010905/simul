+def usable_named_quad(quad, width, height):
+    points = quad.reshape(4, 2)
+    return bool(np.all(points >= 4) and np.all(points <= [width-5, height-5]))
+
+
+def anonymous_center(hit, decoded):
+    point = (float(hit[0]), float(hit[1]))
+    return all(cv2.pointPolygonTest(quad.reshape(4, 2), point, False) < 0 for quad in decoded)
+
+
+def fragment_quads(points):
+    """Retain the measured rectangle and test either missing end of a short axis."""
+    quad = cv2.boxPoints(cv2.minAreaRect(points))
+    edges = np.roll(quad, -1, axis=0) - quad
+    lengths = np.linalg.norm(edges[:2], axis=1)
+    short_index = int(np.argmin(lengths))
+    short, long = min(lengths), max(lengths)
+    if short < .5 * long or long < 6 or short >= 10 or short < 3:
+        return
+    if short >= 6:
+        yield quad
+    if long >= 10 or long - short < .75:
+        return
+    first = np.roll(quad, -short_index, axis=0)
+    extension = edges[short_index] * ((long - short) / short)
+    for side, delta in (([0, 3], -extension), ([1, 2], extension)):
+        proposal = first.copy()
+        proposal[side] += delta
+        yield proposal
+
+
+def fragment_candidates(gray, existing, decoded):
+    """Find small dark printed fragments even when ArUco returned no quad.
+
+    One local min/max pass and up to two connected components per image
+    sector. All geometric completions undergo the native printed-pattern
+    test against the original, unfilled pixels.
+    """
+    if len(existing) >= 8:
+        return []
+    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (15, 15))
+    low, high = cv2.erode(gray, kernel), cv2.dilate(gray, kernel)
+    contrast = cv2.subtract(high, low)
+    dark = cv2.bitwise_and(cv2.compare(gray, cv2.addWeighted(low, .75, high, .25, 0), cv2.CMP_LE),
+                           cv2.compare(contrast, 35, cv2.CMP_GE))
+    _, labels, stats, centers = cv2.connectedComponentsWithStats(dark, connectivity=8)
+    x, y, w, h, area = stats[1:].T
+    # A six-pixel tag at 45 degrees can occupy a larger axis-aligned box.
+    valid = (w >= 4) & (h >= 4) & (w <= 22) & (h <= 22) & (area >= 14)
+    ids = np.flatnonzero(valid) + 1
+    if not len(ids):
+        return []
+    height, width = gray.shape
+    px, py = centers[ids].astype(int).T
+    # Limit fragmentation/textured-background work independently in each sector.
+    quality = contrast[py, px].astype(float) * np.minimum(w[ids-1], h[ids-1]) / np.maximum(w[ids-1], h[ids-1])
+    sectors = np.minimum(3, 4 * py // height) * 4 + np.minimum(3, 4 * px // width)
+    eligible = np.ones(len(ids), dtype=bool)
+    if len(decoded):
+        occupied = np.zeros_like(gray)
+        for quad in decoded:
+            cv2.fillConvexPoly(occupied, np.rint(quad.reshape(4, 2)).astype(np.int32), 255)
+        eligible &= occupied[py, px] == 0
+    for u, v, _, _ in existing:
+        eligible &= (np.abs(centers[ids, 0]-u) >= 4) | (np.abs(centers[ids, 1]-v) >= 4)
+    proposals = []
+    for sector in np.unique(sectors[eligible]):
+        members = np.flatnonzero(eligible & (sectors == sector))
+        for i in members[np.argsort(-quality[members], kind='stable')[:2]]:
+            component = ids[i]
+            left, top, cols, rows, _ = stats[component]
+            ys, xs = np.where(labels[top:top+rows, left:left+cols] == component)
+            points = np.column_stack((xs + left, ys + top)).astype(np.float32)
+            proposals.extend(fragment_quads(points))
+    added = candidates(gray, (), proposals)
+    return [hit for hit in added if anonymous_center(hit, decoded)
+            and all(abs(hit[0]-h[0]) >= 4 or abs(hit[1]-h[1]) >= 4 for h in existing)][:8-len(existing)]
